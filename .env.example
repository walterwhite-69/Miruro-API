# ── Miruro-API environment (AniNami backend) ───────────────────
# Copy to .env and adjust. All values are OPTIONAL — the API runs with none set.

# Port the server listens on. Railway/Koyeb inject PORT automatically; the
# Dockerfile falls back to 8000 when it is unset.
# PORT=8000

# ── Cloudflare / datacenter-IP mitigation ──────────────────────
# Miruro's pipe endpoint and some stream CDNs (owocdn / kwik) are behind
# Cloudflare and HARD-BLOCK datacenter IPs (Railway, Vercel, Render, ...).
# If episodes/sources return 403 or streams fail to load on your host, set a
# residential / clean proxy here to route the blocked requests through it.
#
# Full proxy URL, e.g. http://user:pass@host:port
# OUTBOUND_PROXY=""

# Comma-separated host substrings that should be routed through OUTBOUND_PROXY.
# Keeps metered residential bandwidth to only the hosts that need it.
# OUTBOUND_PROXY_HOSTS="owocdn.top"

# Set to true to ALSO route the Miruro pipe (episodes/sources) requests through
# OUTBOUND_PROXY. Enable this if /api/episodes or /api/watch return 403 on your
# host (typical on Railway/other PaaS with datacenter IPs).
# PIPE_VIA_PROXY="false"
